# Local example only. For a phone, run configure with the actual LAN address.
PORT=3001
HOST=0.0.0.0
PUBLIC_WEB_ORIGIN=http://127.0.0.1:3001
DATABASE_PATH=../data/emergency-qr.sqlite
WEB_DIST_PATH=../frontend/dist
ALLOWED_ORIGINS=http://127.0.0.1:3001,http://localhost:8081
# Leave empty for direct local access. Deployment trusts only its fixed Caddy IP.
TRUST_PROXY=
RATE_LIMIT_CREATE_MAX=10
RATE_LIMIT_CREATE_WINDOW_MS=600000
RATE_LIMIT_OWNER_MAX=120
RATE_LIMIT_OWNER_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=120
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
